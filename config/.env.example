# Copy to config/.env.local and replace every placeholder.
# config/.env.local stays untracked (see .gitignore).

# --- Typesense search cluster ---
TYPESENSE_HOST=http://localhost:8108
TYPESENSE_ADMIN_KEY=replace-with-secure-admin-key
TS_ADMIN_KEY=replace-with-secure-admin-key
COLLECTION=rss_entries

# --- Scanner behaviour ---
PROXY_MODE=proxy-first        # proxy-first | proxy-only | direct-only
BATCH_BUFFER_SIZE=512
TS_IMPORT_BATCH_SIZE=512
SEEN_IDS_MAX=999999999

# --- Networking / certificates ---
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
